#!/bin/sh

TMPDIR=$(mktemp -dt apr-config)
SDK_PATH="$(xcrun --show-sdk-path)"
APR_VERSION="$(pkg-config /usr/lib/pkgconfig/apr-1.pc --modversion)"

cp /usr/local/opt/fakeapxs/libexec/libtool "$TMPDIR/libtool"

curl -s "https://raw.githubusercontent.com/apple-oss-distributions/apr/refs/heads/main/apr/apr/apr-config.in" |
    sed -e "s;\@APR_MAJOR_VERSION\@;${APR_VERSION%%.*};" \
        -e "s;\@APR_DOTTED_VERSION\@;${APR_VERSION};" \
        -e "s;\@prefix\@;/usr;" \
        -e "s;\@exec_prefix\@;/usr;" \
        -e "s;\@bindir\@;/usr/bin;" \
        -e "s;\@libdir\@;${SDK_PATH}/usr/lib;" \
        -e "s;\@datarootdir\@;/usr;" \
        -e "s;\@datadir\@;/usr;" \
        -e "s;\@installbuilddir\@;/usr/share/apr-${APR_VERSION%%.*}/build-${APR_VERSION%%.*};" \
        -e "s;\@includedir\@;${SDK_PATH}/usr/include/apr-${APR_VERSION%%.*};" \
        -e "s;\@CC\@;clang;" \
        -e "s;\@CPP\@;clang -E;" \
        -e "s;\@SHELL\@;/bin/sh;" \
        -e "s;\@EXTRA_CPPFLAGS\@; -DDARWIN -DSIGPROCMASK_SETS_THREAD_MASK;" \
        -e "s;\@EXTRA_CFLAGS\@; -g -O2 -Wall;" \
        -e "s;\@EXTRA_LDFLAGS\@;;" \
        -e "s;\@EXTRA_LIBS\@; -lpthread;" \
        -e "s;\@EXTRA_INCLUDES\@; -I${SDK_PATH}/usr/include/apr-${APR_VERSION%%.*};" \
        -e "s;\@shlibpath_var\@;DYLD_LIBRARY_PATH;" \
        -e "s;\@apr_srcdir\@;${SDK_PATH};" \
        -e "s;\@apr_builddir\@;${TMPDIR};" \
        -e "s;\@so_ext\@;lo;" \
        -e "s;\@export_lib_target\@;-rpath \\\$(libdir) \\\$(OBJECTS);" \
        -e "s;\@APR_LIBNAME\@;apr-${APR_VERSION%%.*};" \
        -e "s;\@APR_CONFIG_LOCATION\@;${TMPDIR};" > "$TMPDIR/apr-config.out"

chmod +x "$TMPDIR/apr-config.out"

output="$("$TMPDIR/apr-config.out" "$@")"

printf "%s: %s\n" "$*" "$output" >> /tmp/apr.log

echo "$output"

exit
